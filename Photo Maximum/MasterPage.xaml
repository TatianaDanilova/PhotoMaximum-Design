<Page x:Class="Photo_Maximum.MasterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Страница мастера" Background="#BDC3C7" Width="850" Height="500" >
    <Page.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="6 3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="2"
                        BorderBrush="#34495E"
                        BorderThickness="1"
                        Padding="8 4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#34495E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#34495E"/>
                                <Setter Property="BorderBrush" Value="#34495E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <!-- Заголовок и кнопка "Назад" -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch">
            <Button Content="Назад" Style="{StaticResource PrimaryButtonStyle}" Click="BackButton_Click" HorizontalAlignment="Left"/>

            <TextBlock Text="Мои заказы" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
        </StackPanel>

        <!-- Список заказов в виде карточек -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="OrdersList" ItemsSource="{Binding}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="5" Padding="10" Margin="0,5">
                            <StackPanel>
                                <!-- Информация о заказе -->
                                <TextBlock Text="{Binding TypeName, StringFormat='Тип: {0}'}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Size, StringFormat='Размер: {0}'}" FontSize="14"/>
                                <TextBlock Text="{Binding Status, StringFormat='Статус: {0}'}" FontSize="14"/>
                                <TextBlock Text="{Binding ClientName, StringFormat='Клиент: {0}'}" FontSize="14"/>
                                <TextBlock Text="{Binding DateStart, StringFormat='Дата начала: {0:dd.MM.yyyy HH:mm}'}" FontSize="14"/>
                                <TextBlock Text="{Binding DateEnd, StringFormat='Дата завершения: {0:dd.MM.yyyy HH:mm}'}" FontSize="14"/>

                                <!-- Кнопки управления -->
                                <StackPanel Orientation="Horizontal" Margin="0,10">
                                    <!-- Кнопки для заказов, ожидающих подтверждения -->
                                    <Button Content="Подтвердить" 
        Style="{StaticResource PrimaryButtonStyle}" 
        Margin="5,0" 
        Click="ConfirmOrder_Click"
        Visibility="{Binding ConfirmButtonVisibility}"/>
                                    <Button Content="Отказаться" 
        Style="{StaticResource PrimaryButtonStyle}" 
        Margin="5,0" 
        Click="RejectOrder_Click"
        Visibility="{Binding RejectButtonVisibility}"/>
                                    <Button Content="Начать выполнение" 
        Style="{StaticResource PrimaryButtonStyle}" 
        Margin="5,0" 
        Click="StartOrder_Click"
        Visibility="{Binding StartButtonVisibility}"/>
                                    <Button Content="Завершить заказ" 
        Style="{StaticResource PrimaryButtonStyle}" 
        Margin="5,0" 
        Click="CompleteOrder_Click"
        Visibility="{Binding CompleteButtonVisibility}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>