<Page x:Class="Photo_Maximum.Client"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Менеджер" Width="850" Height="500" Background="#BDC3C7">
    <Page.Resources>
        <!-- Стиль для карточек -->
        <Style x:Key="OrderCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#34495E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#888"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для кнопок -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#34495E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#34495E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2C3E50"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RewStyle" TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Завершен">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="В процессе">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Шаблон для карточки заказа -->
        <DataTemplate x:Key="OrderCardTemplate">
            <Border Style="{StaticResource OrderCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding Status}" FontSize="18" FontWeight="Bold" Foreground="#34495E"/>
                    <TextBlock Text="{Binding RequestId, StringFormat='Номер заказа: {0}'}" FontSize="14" Foreground="#777"/>
                    <Expander Header="Детали" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Type, StringFormat='Тип: {0}'}" FontSize="14" Foreground="#555"/>
                            <TextBlock Text="{Binding Size, StringFormat='Размер: {0}'}" FontSize="14" Foreground="#555"/>
                            <Image Source="{Binding Photo}" Width="300" Height="300" Margin="0,10"/>

                            <!-- Комментарий -->
                            <TextBlock FontSize="14" Foreground="#555">
                        <Run Text="Комментарий: "/>
                        <Run Text="{Binding Comment, TargetNullValue='комментарий не оставлен'}"/>
                            </TextBlock>

                            <!-- Дата начала -->
                            <TextBlock Text="{Binding DateStart, StringFormat='Дата начала: {0:dd.MM.yyyy HH:mm}'}" FontSize="14" Foreground="#555"/>

                            <!-- Дата завершения -->
                            <TextBlock FontSize="14" Foreground="#555">
                        <Run Text="Дата завершения: "/>
                        <Run Text="{Binding DateEnd, StringFormat='{}{0:dd.MM.yyyy HH:mm}', TargetNullValue='заказ еще не завершен'}"/>
                            </TextBlock>

                            <!-- Исполнитель -->
                            <TextBlock FontSize="14" Foreground="#555">
                        <Run Text="Исполнитель: "/>
                        <Run Text="{Binding Executor, TargetNullValue='исполнитель еще не назначен'}"/>
                            </TextBlock>

                            <!-- Заказчик -->
                            <TextBlock Text="{Binding Customer, StringFormat='Заказчик: {0}'}" FontSize="14" Foreground="#555"/>

                            <Button Content="Оставить отзыв"
                                Style="{StaticResource RewStyle}"
                                Click="LeaveReview_Click"
                                Tag="{Binding RequestId}"/> 
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок и кнопка "Назад" -->
            <RowDefinition Height="Auto"/>
            <!-- Фильтр -->
            <RowDefinition Height="*"/>
            <!-- Список заказов -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопка "Обновить список" -->
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопка "Назад" -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch">
            <Button Content="Назад" Style="{StaticResource PrimaryButtonStyle}" Click="BackButton_Click" HorizontalAlignment="Left"/>
            <TextBlock Text="Заказы" FontSize="32" FontWeight="Bold" Foreground="#34495E" HorizontalAlignment="Center" Margin="10,0"/>
        </StackPanel>

        <!-- Фильтр -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10">
            <TextBlock Text="Фильтр:" FontSize="16" FontWeight="Bold" Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="FilterComboBox" 
                      Width="150" 
                      SelectedIndex="0"
                      SelectionChanged="FilterComboBox_SelectionChanged">
                <ComboBoxItem Content="Актуальные"/>
                <ComboBoxItem Content="Завершенные"/>
            </ComboBox>
        </StackPanel>

        <!-- Список заказов -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
            <StackPanel>
                <!-- Сообщение, если заказов нет -->
                <TextBlock x:Name="NoOrdersText" 
                               Text="У вас пока нет заказов." 
                               FontSize="20" 
                               Foreground="#777" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Margin="0,20" 
                               Visibility="Collapsed"/>

                <!-- Список заказов -->
                <ItemsControl x:Name="ClientRequestsList" ItemTemplate="{StaticResource OrderCardTemplate}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="0,5"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
 
        <!-- Кнопка "Новый заказ" -->
        <Grid Grid.Row="3">
            <Button x:Name="NewRequestButton" Click="NewRequestClick" Content="Новый заказ" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>
    </Grid>
</Page>