<Page x:Class="PhotoMaximuuum.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PhotoMaximuuum"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      xmlns:converters="clr-namespace:PhotoMaximuuum.Converters"
      Title="Авторизация" Background="#FF1E1E1E">
        <Page.Resources>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>   

        <Style TargetType="TextBox">
                <Setter Property="Background" Value="#FF333333"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#FF555555"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="#FF333333"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#FF555555"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Background" Value="#FF555555"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </Page.Resources>

        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                <!-- Заголовок -->
                <TextBlock Text="PhotoMaximuuum" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Поле для логина -->
                <Grid Margin="0,0,0,10">
                    <TextBox x:Name="UserLogin"/>
                    <TextBlock Text="Логин" Foreground="Gray" IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=UserLogin, Converter={StaticResource StringToVisibilityConverter}}"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Поле для пароля -->
                <Grid Margin="0,0,0,20">
                    <PasswordBox x:Name="UserPass"/>
                    <TextBlock Text="Пароль" Foreground="Gray" IsHitTestVisible="False"
                           Visibility="{Binding Password, ElementName=UserPass, Converter={StaticResource StringToVisibilityConverter}}"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Кнопки -->
                <Button Content="Войти" Click="EntryClick" Background="#FF007ACC" Margin="0,0,0,10"/>
                <Button Content="Регистрация" Click="ToRegButton_Click" Background="Transparent" BorderBrush="#FF007ACC" BorderThickness="1"/>
            </StackPanel>
        </Grid>
    </Page>